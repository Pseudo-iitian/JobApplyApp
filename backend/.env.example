# ========================================================
# JobApplyApp - Environment Configuration Template
# ========================================================
# Copy this file to '.env' (or 'backend/.env') and fill in your details:
#   cp .env.example .env
#
# NOTE: DO NOT commit your actual '.env' file to GitHub!
# ========================================================

# --------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------
# Option A: Local SQLite (Default - Works out of the box with zero setup)
DATABASE_URL=sqlite:///./jobapply.db

# Option B: PostgreSQL (e.g. AWS RDS, Supabase, Neon, or Local PostgreSQL)
# Uncomment the line below and replace with your database credentials:
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# --------------------------------------------------------
# 2. AI Inference API Keys (Groq & Google Gemini)
# --------------------------------------------------------
# Groq API Key: Ultra-fast LLM inference (<300ms) for real-time candidate evaluation
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=

# Google Gemini API Key: Deep reasoning & resume tailoring fallback
# Get your free API key at: https://aistudio.google.com/
# (If left empty, the application still works using built-in smart heuristics!)
GEMINI_API_KEY=

# Optional: Preferred Gemini fallback models order
GEMINI_MODEL_CANDIDATES=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# --------------------------------------------------------
# 3. Instant Notification Webhooks (Optional)
# --------------------------------------------------------
# Telegram Alerts: Receive mobile notifications immediately when a matching job is found
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Alerts: Post matching jobs directly to a Discord channel
# Create a webhook in Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------
# 4. 24/7 Background Job Hunter Settings
# --------------------------------------------------------
# Frequency in minutes for the background scheduler to search for new jobs:
SCRAPE_INTERVAL_MINUTES=5

# Default Search Filters:
DEFAULT_KEYWORDS=Spring Boot, Java Developer, Microservices, Backend Developer
DEFAULT_EXPERIENCE=2.0
DEFAULT_LOCATION=All India, Remote, Noida, Bangalore, Pune, Hyderabad, Gurgaon
